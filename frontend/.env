# Frontend Environment Variables
# VITE_API_URL defines the base URL for backend API requests.
# In development, it defaults to http://127.0.0.1:8000/api
# In production, change this URL to your production API server URL (e.g. https://api.yourdomain.com/api)
#VITE_API_URL=https://lms.vibesandbox.live/api
VITE_API_URL=http://127.0.0.1:8000/api
VITE_BACKEND_URL=http://127.0.0.1:8000
